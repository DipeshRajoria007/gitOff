{
  "name": "gitoff",
  "version": "0.1.0",
  "description": "Review GitHub pull requests offline: cache PRs, review in a GitHub-like UI, open branches in Cursor, sync reviews back when online.",
  "keywords": [
    "github",
    "code-review",
    "pull-requests",
    "offline",
    "offline-first",
    "local-first",
    "cli",
    "developer-tools"
  ],
  "homepage": "https://github.com/DipeshRajoria007/gitOff#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DipeshRajoria007/gitOff.git"
  },
  "bugs": {
    "url": "https://github.com/DipeshRajoria007/gitOff/issues"
  },
  "author": "Dipesh Rajoria",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "gitoff": "bin/gitoff.mjs",
    "ogh": "bin/ogh.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:server": "node bin/gitoff.mjs serve --no-open",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@pierre/diffs": "^1.6.4",
    "@primer/octicons-react": "^19.42.0",
    "@primer/primitives": "^11.10.0",
    "@primer/react": "^38.44.0",
    "@tanstack/react-query": "^5.106.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "dompurify": "^3.4.17",
    "github-markdown-css": "^5.9.0",
    "marked": "^18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  }
}
